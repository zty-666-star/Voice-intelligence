<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <!-- 顶部导航栏 + 录屏水印横幅（满足3分钟录屏带本人学号+姓名水印要求） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="智音助手 C3 (自定义指令引擎)"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOpenRules"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="规则库"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnOpenCompanion"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:text="提醒中心(P3)"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnOpenStats"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:text="统计"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWatermark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/watermark_default"
            android:textColor="#BFDBFE"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 权限降级与语音状态提示条 -->
    <TextView
        android:id="@+id/tvPermissionBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FEF3C7"
        android:padding="8dp"
        android:text="状态就绪：支持麦克风语音输入或下方文字/快捷指令直接测试解析引擎"
        android:textColor="#92400E"
        android:textSize="12sp" />

    <!-- 快捷测试指令芯片栏（方便演示与真机/模拟器快速验证规则引擎） -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipQuickReminder"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="10秒后提醒我交安卓作业"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chipQuickDevice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="打开蓝牙"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chipQuickMath"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="计算 128 乘 16"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chipQuickDefense"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="系统状态自检"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 对话与解析结果列表 + 空态视图 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChatList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvEmptyChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="暂无对话记录
请点击下方语音按钮或输入指令体验自定义解析引擎"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底部语音+文本混合输入栏（权限拒绝时平滑降级为纯文本输入） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnVoiceMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="语音输入" />

        <EditText
            android:id="@+id/etCommandInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:hint="输入自然语言指令 (如: 15秒后提醒我喝水)"
            android:inputType="text"
            android:maxLines="2"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSendCommand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="解析执行" />
    </LinearLayout>
</LinearLayout>
